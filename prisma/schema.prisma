generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  PASSPORT
  CV
  NATIONAL_ID
  CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EmployeeWorkMode {
  ON_FIELD
  REMOTE
}

enum AttendanceStatus {
  OPEN
  COMPLETED
  MISSING_CHECKOUT
}

enum AttendanceSource {
  EMPLOYEE
  ADMIN
}

enum AttendanceAuditAction {
  ADMIN_CREATE
  ADMIN_UPDATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

