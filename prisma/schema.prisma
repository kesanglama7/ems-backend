generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  PASSPORT
  CV
  NATIONAL_ID
  CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EmployeeWorkMode {
  ON_FIELD
  REMOTE
}

enum AttendanceStatus {
  OPEN
  COMPLETED
  MISSING_CHECKOUT
}

enum AttendanceSource {
  EMPLOYEE
  ADMIN
}

enum AttendanceAuditAction {
  ADMIN_CREATE
  ADMIN_UPDATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  AUTO_REJECTED
}

enum LeaveDuration {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum LeaveSource {
  EMPLOYEE
  ADMIN
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum EmployeeRequestCategory {
  ATTENDANCE_CORRECTION
  PROFILE_UPDATE
  DOCUMENT
  LEAVE
  PAYROLL
  TECHNICAL_SUPPORT
  WORKPLACE_CONCERN
  GENERAL_QUESTION
  OTHER
}

enum EmployeeRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
  DISMISSED
  CANCELLED
}

enum EmployeeRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EmployeeRequestActivityAction {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  ADMIN_NOTE_UPDATED
  DISMISSED
  CANCELLED
}

enum EmployeeRequestDismissalReason {
  SPAM_OR_INAPPROPRIATE
  DUPLICATE
  INVALID_REQUEST
  INSUFFICIENT_INFORMATION
  OTHER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)

  employee                  Employee?
  authSessions              AuthSession[]
  pushDeviceTokens          PushDeviceToken[]
  notifications             Notification[]            @relation("NotificationRecipient")
  notificationActions       Notification[]            @relation("NotificationActor")
  assignedEmployeeRequests  EmployeeRequest[]         @relation("EmployeeRequestAssignee")
  resolvedEmployeeRequests  EmployeeRequest[]         @relation("EmployeeRequestResolver")
  dismissedEmployeeRequests EmployeeRequest[]         @relation("EmployeeRequestDismisser")
  employeeRequestActivities EmployeeRequestActivity[]
  authoredAnnouncements       Announcement[]          @relation("AnnouncementAuthor")
  announcementReceipts        AnnouncementReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushDeviceTokens PushDeviceToken[]

  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  employee Employee[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(uuid())

  employeeCode String @unique

  firstName String
  lastName  String

  phone    String?
  jobTitle String?

  workMode EmployeeWorkMode @default(ON_FIELD)

  dateOfJoining DateTime?

  profileImagePath String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  documents        EmployeeDocument[]
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  leaveBalances    EmployeeLeaveBalance[]
  employeeRequests EmployeeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeDocument {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type DocumentType

  title String

  originalFileName String
  mimeType         String
  fileSize         Int

  bucket      String
  storagePath String

  status DocumentStatus @default(PENDING)

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeSetting {
  id String @id @default(uuid())

  officeName String

  timezone String @default("Asia/Kathmandu")

  workStartTime String
  workEndTime   String

  workingDays String[]

  gracePeriodMinutes Int @default(0)

  // Office geographic configuration
  officeLatitude         Float?
  officeLongitude        Float?
  officeAddress          String?
  attendanceRadiusMeters Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime

  status AttendanceStatus @default(OPEN)
  source AttendanceSource @default(EMPLOYEE)

  // Employee configuration snapshot
  workModeSnapshot EmployeeWorkMode?

  // Office schedule snapshot
  officeTimezoneSnapshot     String?
  scheduledStartAt           DateTime?
  scheduledEndAt             DateTime?
  gracePeriodMinutesSnapshot Int?
  scheduledMinutes           Int?

  // Office geofence snapshot
  officeLatitudeSnapshot     Float?
  officeLongitudeSnapshot    Float?
  officeRadiusMetersSnapshot Int?

  // Actual check-in data
  checkInAt  DateTime
  checkOutAt DateTime?

  // Check-in location
  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInAccuracyMeters Float?
  checkInDistanceMeters Float?

  // Check-out location
  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutAccuracyMeters Float?
  checkOutDistanceMeters Float?

  // Attendance calculations
  isLate            Boolean @default(false)
  lateMinutes       Int     @default(0)
  earlyMinutes      Int     @default(0)
  afterHoursMinutes Int     @default(0)
  totalMinutes      Int?
  overtimeMinutes   Int?

  audits           AttendanceAudit[]
  employeeRequests EmployeeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, workDate])
  @@index([employeeId])
  @@index([workDate])
  @@index([status])
}

model AttendanceAudit {
  id String @id @default(uuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  adminUserId String

  action AttendanceAuditAction

  reason String

  before Json?
  after  Json

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([adminUserId])
}

model LeaveType {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  isActive Boolean @default(true)

  yearlyAllowance       Decimal @default(0) @db.Decimal(6, 2)
  hasLimitedBalance     Boolean @default(false)
  allowHalfDay          Boolean @default(true)
  isEmployeeRequestable Boolean @default(true)
  isPaid                Boolean @default(true)
  isSystem              Boolean @default(false)

  leaveRequests LeaveRequest[]
  leaveBalances EmployeeLeaveBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveRequest {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate DateTime
  endDate   DateTime

  reason String?

  status           LeaveStatus   @default(PENDING)
  duration         LeaveDuration @default(FULL_DAY)
  requestedDays    Decimal       @default(1) @db.Decimal(6, 2)
  source           LeaveSource   @default(EMPLOYEE)
  reviewDeadlineAt DateTime?
  reminderSentAt   DateTime?
  autoRejectedAt   DateTime?
  createdByUserId  String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate, endDate])
  @@index([status, reviewDeadlineAt])
}

model EmployeeLeaveBalance {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  year        Int
  totalDays   Decimal @default(0) @db.Decimal(6, 2)
  usedDays    Decimal @default(0) @db.Decimal(6, 2)
  pendingDays Decimal @default(0) @db.Decimal(6, 2)

  adjustments LeaveBalanceAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

model LeaveBalanceAdjustment {
  id                     String               @id @default(uuid())
  employeeLeaveBalanceId String
  employeeLeaveBalance   EmployeeLeaveBalance @relation(fields: [employeeLeaveBalanceId], references: [id], onDelete: Cascade)
  adjustmentDays         Decimal              @db.Decimal(6, 2)
  reason                 String
  adminUserId            String
  createdAt              DateTime             @default(now())

  @@index([employeeLeaveBalanceId])
  @@index([adminUserId])
}

model PushDeviceToken {
  sessionId  String?
  session    AuthSession?           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime               @default(now())
  deliveries NotificationDelivery[]
  id         String                 @id @default(uuid())
  token      String                 @unique
  platform   PushPlatform
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([lastSeenAt])
}

enum NotificationCategory {
  LEAVE
  REQUEST
  DOCUMENT
  ATTENDANCE
  ANNOUNCEMENT
}

enum NotificationType {
  ANNOUNCEMENT_PUBLISHED
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_AUTO_REJECTED
  LEAVE_CANCELLED
  LEAVE_REMINDER
  LEAVE_CREATED_BY_ADMIN
  LEAVE_BALANCE_ADJUSTED
  EMPLOYEE_REQUEST_CREATED
  EMPLOYEE_REQUEST_STATUS_CHANGED
  EMPLOYEE_REQUEST_ASSIGNED
  EMPLOYEE_REQUEST_CANCELLED
  EMPLOYEE_REQUEST_DISMISSED
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  DOCUMENT_DELETED
  ATTENDANCE_CREATED_BY_ADMIN
  ATTENDANCE_UPDATED_BY_ADMIN
}

enum NotificationEntityType {
  ANNOUNCEMENT
  LEAVE_REQUEST
  EMPLOYEE_REQUEST
  DOCUMENT
  ATTENDANCE
  LEAVE_BALANCE
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  ACCEPTED
  FAILED
  SKIPPED
}

model Notification {
  id              String                 @id @default(uuid())
  recipientUserId String
  recipient       User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actor           User?                  @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventId         String
  type            NotificationType
  category        NotificationCategory
  title           String                 @db.VarChar(160)
  message         String                 @db.VarChar(500)
  entityType      NotificationEntityType
  entityId        String
  readAt          DateTime?
  createdAt       DateTime               @default(now())
  expiresAt       DateTime
  deliveries      NotificationDelivery[]

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, createdAt, id])
  @@index([recipientUserId, readAt, expiresAt])
  @@index([expiresAt])
  @@index([entityType, entityId])
}

model NotificationDelivery {
  id              String                     @id @default(uuid())
  notificationId  String
  notification    Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceTokenId   String?
  deviceToken     PushDeviceToken?           @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  targetSessionId String?
  status          NotificationDeliveryStatus @default(PENDING)
  attempts        Int                        @default(0)
  nextAttemptAt   DateTime                   @default(now())
  lockedUntil     DateTime?
  claimToken      String?
  acceptedAt      DateTime?
  lastErrorCode   String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([notificationId, deviceTokenId])
  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([deviceTokenId])
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_EMPLOYEES
  DEPARTMENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model Announcement {
  id                      String               @id @default(uuid())
  title                   String               @db.VarChar(160)
  body                    String               @db.Text
  priority                AnnouncementPriority @default(NORMAL)
  status                  AnnouncementStatus   @default(DRAFT)
  audience                AnnouncementAudience @default(ALL_EMPLOYEES)
  departmentId            String?
  department              Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  showOnLogin             Boolean              @default(false)
  acknowledgmentRequired Boolean              @default(false)
  publishAt               DateTime?
  publishedAt             DateTime?
  expiresAt               DateTime?
  archivedAt              DateTime?
  authorId                String
  author                  User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  receipts                AnnouncementReceipt[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([status, publishAt])
  @@index([status, expiresAt])
  @@index([departmentId])
}

model AnnouncementReceipt {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId, readAt])
}

model EmployeeRequest {
  id String @id @default(uuid())

  requestNumber Int @unique @default(autoincrement())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  category    EmployeeRequestCategory
  subject     String
  description String
  status      EmployeeRequestStatus   @default(OPEN)
  priority    EmployeeRequestPriority @default(NORMAL)

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  assignedAdminId String?
  assignedAdmin   User?   @relation("EmployeeRequestAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  resolvedByAdminId String?
  resolvedByAdmin   User?   @relation("EmployeeRequestResolver", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  dismissedByAdminId String?
  dismissedByAdmin   User?   @relation("EmployeeRequestDismisser", fields: [dismissedByAdminId], references: [id], onDelete: SetNull)

  adminNote       String?
  resolutionNote  String?
  resolvedAt      DateTime?
  dismissalReason EmployeeRequestDismissalReason?
  dismissalNote   String?
  dismissedAt     DateTime?

  activities EmployeeRequestActivity[]
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([employeeId, status])
  @@index([category, status])
  @@index([assignedAdminId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model EmployeeRequestActivity {
  id String @id @default(uuid())

  requestId String
  request   EmployeeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  performedByUserId String?
  performedBy       User?   @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  action     EmployeeRequestActivityAction
  fromStatus EmployeeRequestStatus?
  toStatus   EmployeeRequestStatus?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([performedByUserId])
}
