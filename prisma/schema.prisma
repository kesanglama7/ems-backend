//new user and AuthSession model to support multiple auth tokens system
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)

  employee      Employee?
  authSessions  AuthSession[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  employee Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(uuid())

  employeeCode String @unique

  firstName String
  lastName  String

  phone    String?
  jobTitle String?

  workMode EmployeeWorkMode @default(ON_FIELD)

  dateOfJoining DateTime?

  profileImagePath String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  documents     EmployeeDocument[]
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  leaveBalances EmployeeLeaveBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeDocument {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type DocumentType

  title String

  originalFileName String
  mimeType         String
  fileSize         Int

  bucket      String
  storagePath String

  status DocumentStatus @default(PENDING)

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeSetting {
  id String @id @default(uuid())

  officeName String

  timezone String @default("Asia/Kathmandu")

  workStartTime String
  workEndTime   String

  workingDays String[]

  gracePeriodMinutes Int @default(0)

  // Office geographic configuration
  officeLatitude         Float?
  officeLongitude        Float?
  officeAddress          String?
  attendanceRadiusMeters Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime

  status AttendanceStatus @default(OPEN)
  source AttendanceSource @default(EMPLOYEE)

  // Employee configuration snapshot
  workModeSnapshot EmployeeWorkMode?

  // Office schedule snapshot
  officeTimezoneSnapshot     String?
  scheduledStartAt           DateTime?
  scheduledEndAt             DateTime?
  gracePeriodMinutesSnapshot Int?
  scheduledMinutes           Int?

  // Office geofence snapshot
  officeLatitudeSnapshot     Float?
  officeLongitudeSnapshot    Float?
  officeRadiusMetersSnapshot Int?

  // Actual check-in data
  checkInAt  DateTime
  checkOutAt DateTime?

  // Check-in location
  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInAccuracyMeters Float?
  checkInDistanceMeters Float?

  // Check-out location
  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutAccuracyMeters Float?
  checkOutDistanceMeters Float?

  // Attendance calculations
  isLate            Boolean @default(false)
  lateMinutes       Int     @default(0)
  earlyMinutes      Int     @default(0)
  afterHoursMinutes Int     @default(0)
  totalMinutes      Int?
  overtimeMinutes   Int?

  audits AttendanceAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, workDate])
  @@index([employeeId])
  @@index([workDate])
  @@index([status])
}

model AttendanceAudit {
  id String @id @default(uuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  adminUserId String

  action AttendanceAuditAction

  reason String

  before Json?
  after  Json

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([adminUserId])
}

model LeaveType {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  isActive Boolean @default(true)

  yearlyAllowance       Decimal @default(0) @db.Decimal(6, 2)
  hasLimitedBalance     Boolean @default(false)
  allowHalfDay          Boolean @default(true)
  isEmployeeRequestable Boolean @default(true)
  isPaid                Boolean @default(true)
  isSystem              Boolean @default(false)

  leaveRequests LeaveRequest[]
  leaveBalances EmployeeLeaveBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveRequest {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate DateTime
  endDate   DateTime

  reason String?

  status           LeaveStatus   @default(PENDING)
  duration         LeaveDuration @default(FULL_DAY)
  requestedDays    Decimal       @default(1) @db.Decimal(6, 2)
  source           LeaveSource   @default(EMPLOYEE)
  reviewDeadlineAt DateTime?
  reminderSentAt   DateTime?
  autoRejectedAt   DateTime?
  createdByUserId  String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([employeeId, startDate, endDate])
  @@index([status, reviewDeadlineAt])
}

model EmployeeLeaveBalance {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  year        Int
  totalDays   Decimal @default(0) @db.Decimal(6, 2)
  usedDays    Decimal @default(0) @db.Decimal(6, 2)
  pendingDays Decimal @default(0) @db.Decimal(6, 2)

  adjustments LeaveBalanceAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

model LeaveBalanceAdjustment {
  id                     String               @id @default(uuid())
  employeeLeaveBalanceId String
  employeeLeaveBalance   EmployeeLeaveBalance @relation(fields: [employeeLeaveBalanceId], references: [id], onDelete: Cascade)
  adjustmentDays         Decimal              @db.Decimal(6, 2)
  reason                 String
  adminUserId            String
  createdAt              DateTime             @default(now())

  @@index([employeeLeaveBalanceId])
  @@index([adminUserId])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  leaveRequestId String?
  leaveRequest   LeaveRequest?    @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
