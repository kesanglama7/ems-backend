generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  PASSPORT
  CV
  NATIONAL_ID
  CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EmployeeWorkMode {
  ON_FIELD
  REMOTE
}

enum AttendanceStatus {
  OPEN
  COMPLETED
  MISSING_CHECKOUT
}

enum AttendanceSource {
  EMPLOYEE
  ADMIN
}

enum AttendanceAuditAction {
  ADMIN_CREATE
  ADMIN_UPDATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  AUTO_REJECTED
}

enum LeaveDuration {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum LeaveSource {
  EMPLOYEE
  ADMIN
}

enum NotificationType {
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_AUTO_REJECTED
  LEAVE_CANCELLED
  LEAVE_REMINDER
  LEAVE_CREATED_BY_ADMIN
}

